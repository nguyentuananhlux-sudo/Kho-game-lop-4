    "subject": "Toán",
    "fileContent": "<!DOCTYPE html><html lang='vi'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>Trò Chơi: Tính Nhanh</title><script src='https://cdn.tailwindcss.com'></script></head><body class='bg-slate-50 flex flex-col items-center justify-center p-4 min-h-screen'><div class='bg-white w-full max-w-xl rounded-3xl shadow-xl p-6 text-center'><h1 class='text-2xl font-black text-indigo-900 mb-4'>⚡ TÍNH NHANH SIÊU TỐC ⚡</h1><div class='flex justify-between bg-indigo-50 px-4 py-2 rounded-xl mb-4 font-bold text-indigo-700'><span>Điểm: <strong id='score'>0</strong></span><span>Thời gian: <strong id='timer' class='text-rose-600'>30</strong>s</span></div><div class='bg-indigo-600 text-white rounded-2xl p-6 mb-4'><div id='question' class='text-3xl font-black'>12 + 15 = ?</div></div><div id='options' class='grid grid-cols-2 gap-3 mb-4'></div><button id='startBtn' onclick='startGame()' class='bg-indigo-600 text-white font-black px-6 py-3 rounded-xl w-full'>🚀 BẮT ĐẦU CHƠI</button></div><script>let score=0,timeLeft=30,timerInterval=null,correctAnswer=0;function startGame(){score=0;timeLeft=30;document.getElementById('score').textContent=score;document.getElementById('timer').textContent=timeLeft;document.getElementById('startBtn').style.display='none';nextQuestion();clearInterval(timerInterval);timerInterval=setInterval(()=>{timeLeft--;document.getElementById('timer').textContent=timeLeft;if(timeLeft<=0){clearInterval(timerInterval);document.getElementById('question').textContent='Hết giờ! Điểm: '+score;document.getElementById('options').innerHTML='';document.getElementById('startBtn').style.display='block';}},1000);}function nextQuestion(){let n1=Math.floor(Math.random()*50)+10,n2=Math.floor(Math.random()*50)+10;correctAnswer=n1+n2;document.getElementById('question').textContent=`${n1} + ${n2} = ?`;let ans=[correctAnswer];while(ans.length<4){let w=correctAnswer+Math.floor(Math.random()*10)-5;if(w!==correctAnswer&&!ans.includes(w)&&w>=0)ans.push(w);}ans.sort(()=>Math.random()-0.5);let box=document.getElementById('options');box.innerHTML='';ans.forEach(a=>{let btn=document.createElement('button');btn.className='bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-900 font-black text-lg py-3 rounded-xl border border-indigo-100';btn.textContent=a;btn.onclick=()=>{if(a===correctAnswer)score+=10;document.getElementById('score').textContent=score;nextQuestion();};box.appendChild(btn);});}</script></body></html>"
  }
