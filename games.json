    "subject": "Toán",
    "fileContent": "<!DOCTYPE html><html lang='vi'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>Thử Thách Tính Nhanh - Toán Lớp 4 (Offline)</title><style>* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; } body { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); min-height: 100vh; display: flex; justify-content: center; align-items: center; padding: 20px; } .container { background: #ffffff; width: 100%; max-width: 650px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); padding: 30px; text-align: center; } h1 { color: #2c3e50; font-size: 24px; margin-bottom: 8px; } .subtitle { color: #7f8c8d; font-size: 14px; margin-bottom: 25px; } .screen { display: none; } .screen.active { display: block; } .btn-start { background-color: #2ecc71; color: white; border: none; padding: 14px 35px; font-size: 18px; font-weight: bold; border-radius: 50px; cursor: pointer; transition: 0.2s; box-shadow: 0 4px 15px rgba(46, 204, 113, 0.4); } .btn-start:hover { background-color: #27ae60; transform: translateY(-2px); } .quiz-header { display: flex; justify-content: space-between; background: #f8f9fa; padding: 12px 20px; border-radius: 10px; font-weight: bold; color: #34495e; margin-bottom: 25px; font-size: 15px; } .question-box { font-size: 20px; color: #2c3e50; font-weight: bold; margin-bottom: 25px; min-height: 70px; display: flex; align-items: center; justify-content: center; padding: 0 10px; } .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px; } .option-btn { background: #ffffff; border: 2px solid #e2e8f0; border-radius: 12px; padding: 15px; font-size: 16px; font-weight: 600; color: #2d3748; cursor: pointer; transition: all 0.2s; } .option-btn:hover { background: #ebf8ff; border-color: #3182ce; color: #2b6cb0; } .result-card { background: #f7fafc; border-radius: 15px; padding: 20px; margin-bottom: 20px; } .score-big { font-size: 42px; font-weight: bold; color: #e67e22; margin: 10px 0; } .stats-grid { display: flex; justify-content: space-around; margin: 15px 0; font-size: 15px; color: #4a5568; } .details-container { max-height: 250px; overflow-y: auto; text-align: left; border: 1px solid #e2e8f0; border-radius: 10px; padding: 15px; margin-bottom: 20px; background: #fff; } .detail-item { font-size: 14px; padding: 8px 0; border-bottom: 1px solid #f1f5f9; } .detail-item.correct { color: #27ae60; } .detail-item.incorrect { color: #c0392b; } .btn-group { display: flex; gap: 12px; justify-content: center; } .btn-action { background: #3498db; color: white; border: none; padding: 12px 25px; font-size: 16px; font-weight: bold; border-radius: 8px; cursor: pointer; transition: 0.2s; } .btn-action:hover { background: #2980b9; } .btn-home { background: #7f8c8d; } .btn-home:hover { background: #6c7a89; }</style></head><body><div class='container'><div id='start-screen' class='screen active'><h1>🧮 Thử Thách Tính Nhanh Toán 4</h1><p class='subtitle'>Luyện tập phản xạ nhân chia, góc, đại lượng và biểu thức (10 câu hỏi ngẫu nhiên)</p><button class='btn-start' onclick='startGame()'>Bắt Đầu Chơi</button></div><div id='quiz-screen' class='screen'><div class='quiz-header'><span id='question-progress'>Câu hỏi: 1 / 10</span><span id='timer-display'>⏱️ Thời gian: 0s</span></div><div class='question-box' id='question-text'>Đang tải câu hỏi...</div><div class='options-grid' id='options-container'></div></div><div id='result-screen' class='screen'><h1>🎉 Hoàn Thành Thử Thách!</h1><div class='result-card'><p>Điểm số của bạn (Thang 100):</p><div class='score-big' id='final-score'>100đ</div><div class='stats-grid'><div>✅ Đúng: <strong id='correct-count'>10</strong>/10</div><div>⏱️ Tổng thời gian: <strong id='total-time'>0s</strong></div></div></div><p style='text-align: left; font-weight: bold; margin-bottom: 8px; color: #2c3e50; font-size: 14px;'>Chi tiết đáp án:</p><div class='details-container' id='details-container'></div><div class='btn-group'><button class='btn-action' onclick='startGame()'>Chơi Lại</button><button class='btn-action btn-home' onclick='goHome()'>🏠 Về Trang Chủ</button></div></div></div><script>const questionBank=[{q:\"Tính giá trị biểu thức: 2450 × 4 = ?\",options:[\"9800\",\"8900\",\"9600\",\"10000\"],answer:\"9800\"},{q:\"Tính giá trị biểu thức: 3200 × 3 = ?\",options:[\"9600\",\"9300\",\"9900\",\"6400\"],answer:\"9600\"},{q:\"Tính giá trị biểu thức: 1250 × 8 = ?\",options:[\"10000\",\"9000\",\"11000\",\"9500\"],answer:\"10000\"},{q:\"Tính giá trị biểu thức: 4100 × 2 = ?\",options:[\"8200\",\"8400\",\"8100\",\"8500\"],answer:\"8200\"},{q:\"Tính giá trị biểu thức: 1500 × 5 = ?\",options:[\"7500\",\"7000\",\"8000\",\"6500\"],answer:\"7500\"},{q:\"Thực hiện phép tính: 8400 : 4 = ?\",options:[\"2100\",\"2050\",\"2200\",\"2150\"],answer:\"2100\"},{q:\"Thực hiện phép tính: 6300 : 3 = ?\",options:[\"2100\",\"2300\",\"2000\",\"2200\"],answer:\"2100\"},{q:\"Thực hiện phép tính: 9600 : 8 = ?\",options:[\"1200\",\"1100\",\"1300\",\"1250\"],answer:\"1200\"},{q:\"Thực hiện phép tính: 4500 : 5 = ?\",options:[\"900\",\"800\",\"950\",\"850\"],answer:\"900\"},{q:\"Thực hiện phép tính: 7200 : 9 = ?\",options:[\"800\",\"700\",\"900\",\"850\"],answer:\"800\"}];let currentQuestions=[],currentIndex=0,score=0,correctCount=0,startTime=0,timerInterval=null,elapsedTime=0,userAnswersLog=[];function shuffleArray(array){let arr=[...array];for(let i=arr.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];}return arr;}function startGame(){let shuffledBank=shuffleArray(questionBank);currentQuestions=shuffledBank.slice(0,10);currentIndex=0;correctCount=0;score=0;elapsedTime=0;userAnswersLog=[];document.getElementById('start-screen').classList.remove('active');document.getElementById('result-screen').classList.remove('active');document.getElementById('quiz-screen').classList.add('active');startTime=Date.now();if(timerInterval)clearInterval(timerInterval);timerInterval=setInterval(()=>{elapsedTime=Math.floor((Date.now()-startTime)/1000);document.getElementById('timer-display').innerText=`⏱️ Thời gian: ${elapsedTime}s`;},1000);loadQuestion();}function loadQuestion(){if(currentIndex>=currentQuestions.length){endGame();return;}let qData=currentQuestions[currentIndex];document.getElementById('question-progress').innerText=`Câu hỏi: ${currentIndex+1} / 10`;document.getElementById('question-text').innerText=qData.q;let optionsContainer=document.getElementById('options-container');optionsContainer.innerHTML='';let shuffledOptions=shuffleArray(qData.options);shuffledOptions.forEach(opt=>{let btn=document.createElement('button');btn.className='option-btn';btn.innerText=opt;btn.onclick=()=>selectAnswer(opt,qData.answer,qData.q);optionsContainer.appendChild(btn);});}function selectAnswer(selected,correct,questionText){let isCorrect=(selected===correct);if(isCorrect){correctCount++;}userAnswersLog.push({question:questionText,selected:selected,correct:correct,isCorrect:isCorrect});currentIndex++;loadQuestion();}function endGame(){clearInterval(timerInterval);score=correctCount*10;document.getElementById('quiz-screen').classList.remove('active');document.getElementById('result-screen').classList.add('active');document.getElementById('final-score').innerText=`${score}đ`;document.getElementById('correct-count').innerText=correctCount;document.getElementById('total-time').innerText=`${elapsedTime}s`;let detailsContainer=document.getElementById('details-container');detailsContainer.innerHTML='';userAnswersLog.forEach((item,index)=>{let div=document.createElement('div');div.className=`detail-item ${item.isCorrect?'correct':'incorrect'}`;div.innerHTML=`<strong>C${index+1}:</strong> ${item.question}<br>👉 Bạn chọn: <b>${item.selected}</b> |